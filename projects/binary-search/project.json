    {"id": "code-highlight", "type": "rect", "name": "Code highlight", "props": {"x": 299.4, "y": 54.3, "w": 578.8, "h": 40.6, "fill": "rgba(176,124,245,0.18)", "radius": 8}, "parent": "code"},
    {"id": "code-text", "type": "text", "name": "Code text", "props": {"x": 299.4, "y": 176.1, "w": 530.8, "h": 284, "text": "[[#b07cf5|int]] lo = [[#ff5ef1|0]], hi = n - [[#ff5ef1|1]];\n[[#b07cf5|while]] (lo <= hi) {\n  [[#b07cf5|int]] mid = (lo + hi) / [[#ff5ef1|2]];\n  [[#b07cf5|if]] (a[mid] == x) [[#b07cf5|return]] mid;\n  [[#b07cf5|if]] (a[mid] < x) lo = mid + [[#ff5ef1|1]];\n  [[#b07cf5|else]] hi = mid - [[#ff5ef1|1]];\n}", "font": "JetBrains Mono", "size": 28, "weight": 400, "color": "#e6e1f2", "align": "left", "lineHeight": 1.45, "reveal": "type"}, "parent": "code"},
