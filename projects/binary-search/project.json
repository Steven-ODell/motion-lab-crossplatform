    {"id": "n2", "track": "narration", "src": "assets/narr-962aa4ebc53e.wav", "start": 4.398, "offset": 0, "dur": 2.012, "srcDur": 2.012, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "We're looking for thirty seven.", "voice": "bm_george", "speed": 1.1, "voiced": "We're looking for thirty seven."},
    {"id": "n3", "track": "narration", "src": "assets/narr-bdcc2009ff57.wav", "start": 6.76, "offset": 0, "dur": 2.466, "srcDur": 2.466, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Check the middle. Sixteen is too small.", "voice": "bm_george", "speed": 1.1, "voiced": "Check the middle. Sixteen is too small."},
    {"id": "n4", "track": "narration", "src": "assets/narr-0a0bc334bcc4.wav", "start": 9.576, "offset": 0, "dur": 3.523, "srcDur": 3.523, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "So the whole left half is gone. Thirty seven can't be there.", "voice": "bm_george", "speed": 1.1, "voiced": "So the whole left half is gone. Thirty seven can't be there."},
    {"id": "n5", "track": "narration", "src": "assets/narr-7144664f2a6c.wav", "start": 13.449, "offset": 0, "dur": 2.545, "srcDur": 2.545, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Check the middle of what's left, and cut again.", "voice": "bm_george", "speed": 1.1, "voiced": "Check the middle of what's left, and cut again."},
    {"id": "n6", "track": "narration", "src": "assets/narr-ac2fa8e8388d.wav", "start": 17.744, "offset": 0, "dur": 3.383, "srcDur": 3.383, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Found it, in two checks. Going one by one takes seven.", "voice": "bm_george", "speed": 1.1, "voiced": "Found it, in two checks. Going one by one takes seven."},
    {"id": "n7", "track": "narration", "src": "assets/narr-88128e377b90.wav", "start": 21.477, "offset": 0, "dur": 4.088, "srcDur": 4.088, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Each check halves the list, so a million numbers take about twenty checks.", "voice": "bm_george", "speed": 1.1, "voiced": "Each check halves the list, so a million numbers take about twenty checks."}
  ],
