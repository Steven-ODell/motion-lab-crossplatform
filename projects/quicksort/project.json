    {"id": "caption-1", "type": "text", "name": "Caption 1", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Quicksort. One idea, used over and over.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 158, "size": 60}},
    {"id": "caption-2", "type": "text", "name": "Caption 2", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Pick a number. We'll call it the pivot.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 158, "size": 60}},
    {"id": "caption-3", "type": "text", "name": "Caption 3", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 128, "text": "Everything smaller goes to its left. Everything bigger goes to its right.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 233, "size": 60}},
    {"id": "caption-4", "type": "text", "name": "Caption 4", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Now the pivot is in its final spot. It never moves again.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 158, "size": 60}},
    {"id": "caption-5", "type": "text", "name": "Caption 5", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Then do the exact same thing to each side.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 158, "size": 60}},
    {"id": "caption-6", "type": "text", "name": "Caption 6", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Pick a pivot. Split. Repeat.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 83, "size": 60}},
    {"id": "caption-7", "type": "text", "name": "Caption 7", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 68, "text": "Until every piece is a single number.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 158, "size": 60}},
    {"id": "caption-8", "type": "text", "name": "Caption 8", "props": {"x": 960.0, "y": 988.2, "w": 1536.0, "h": 128, "text": "Sorted. About n log n steps on average, and C++'s std::sort is built on this idea.", "font": "Inter", "size": 48, "weight": 600, "color": "#e6e1f2", "align": "center", "lineHeight": 1.25, "reveal": "fade"}, "folder": "f-captions", "tall": {"x": 540.0, "y": 1536.0, "w": 950.4, "h": 233, "size": 60}}
