  "audio": [
    {"id": "n1", "track": "narration", "src": "assets/narr-536fc5a57db7.wav", "start": 0.6, "offset": 0, "dur": 2.797, "srcDur": 2.797, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Quicksort. One idea, used over and over.", "voice": "bm_george", "speed": 1.1, "voiced": "Quicksort. One idea, used over and over."},
    {"id": "n2", "track": "narration", "src": "assets/narr-d67451114111.wav", "start": 3.797, "offset": 0, "dur": 2.176, "srcDur": 2.176, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Pick a number. We'll call it the pivot.", "voice": "bm_george", "speed": 1.1, "voiced": "Pick a number. We'll call it the pivot."},
    {"id": "n3", "track": "narration", "src": "assets/narr-f0cc992ca6ef.wav", "start": 6.373, "offset": 0, "dur": 4.351, "srcDur": 4.351, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Everything smaller goes to its left. Everything bigger goes to its right.", "voice": "bm_george", "speed": 1.1, "voiced": "Everything smaller goes to its left. Everything bigger goes to its right."},
    {"id": "n4", "track": "narration", "src": "assets/narr-49d3c794b537.wav", "start": 11.324, "offset": 0, "dur": 3.917, "srcDur": 3.917, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Now the pivot is in its final spot. It never moves again.", "voice": "bm_george", "speed": 1.1, "voiced": "Now the pivot is in its final spot. It never moves again."},
    {"id": "n5", "track": "narration", "src": "assets/narr-d0a8327b2b95.wav", "start": 15.641, "offset": 0, "dur": 2.445, "srcDur": 2.445, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Then do the exact same thing to each side.", "voice": "bm_george", "speed": 1.1, "voiced": "Then do the exact same thing to each side."},
    {"id": "n6", "track": "narration", "src": "assets/narr-10dde1316b96.wav", "start": 18.486, "offset": 0, "dur": 1.991, "srcDur": 1.991, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Pick a pivot. Split. Repeat.", "voice": "bm_george", "speed": 1.1, "voiced": "Pick a pivot. Split. Repeat."},
    {"id": "n7", "track": "narration", "src": "assets/narr-d0a636b7a124.wav", "start": 22.477, "offset": 0, "dur": 2.469, "srcDur": 2.469, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Until every piece is a single number.", "voice": "bm_george", "speed": 1.1, "voiced": "Until every piece is a single number."},
    {"id": "n8", "track": "narration", "src": "assets/narr-dd898b576f73.wav", "start": 27.146, "offset": 0, "dur": 6.681, "srcDur": 6.681, "volume": 1, "fadeIn": 0, "fadeOut": 0, "text": "Sorted. About n log n steps on average, and C plus plus's standard sort is built on this idea.", "voice": "bm_george", "speed": 1.1, "voiced": "Sorted. About n log n steps on average, and C plus plus's standard sort is built on this idea."}
  ],
